# Copy to .env for local work; on a host, set these as environment variables.
# Never commit the filled-in version — .gitignore already excludes .env.

# ── Supabase ────────────────────────────────────────────────────────────────
# Used ONLY to verify the caller's token (supabase.auth.getUser). The anon key
# is the right one here: this server never needs to act as anyone, only to ask
# Supabase whether a presented token belongs to a real, current user.
#
# ⚠️ Never put the SERVICE ROLE key here. It bypasses row-level security, and
# this box is reachable from the internet.
#
# Without these the paid endpoints return 503 and refuse every request. That is
# deliberate — a misconfigured proxy must fail closed, never open.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Google Gemini ───────────────────────────────────────────────────────────
# The whole reason this server exists. The key lives here and nowhere else:
# anything named EXPO_PUBLIC_* is compiled into the shipped app bundle and can
# be extracted from any installed copy, then billed to us.
GEMINI_API_KEY=
# Optional. Falls back to gemini-3.1-flash-lite; the app usually names its own
# model per request, and the proxy only honours a known-good list.
GEMINI_MODEL=

# ── FatSecret ───────────────────────────────────────────────────────────────
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# Only set true if the paid NLP add-on has been purchased. Anything else leaves
# the free search path in use.
USE_NATIVE_NLP=false

# ── Host ────────────────────────────────────────────────────────────────────
# Do NOT set this on a PaaS. Railway, Render and Fly inject their own PORT, and
# hard-coding one makes the container listen where nothing is routed — which
# presents as a deploy that builds fine and then fails its health check.
# PORT=4000
